# ---- Firebase config (repo may be public) ----
# google-services.json and the two files the Firebase editor plugin generates from it
# (same API key / project IDs). Keep the real files locally; Unity regenerates the derived ones.
google-services.json
google-services.json.meta
GoogleService-Info.plist
GoogleService-Info.plist.meta
/ArrowPuzzle/Assets/StreamingAssets/google-services-desktop.json
/ArrowPuzzle/Assets/StreamingAssets/google-services-desktop.json.meta
/ArrowPuzzle/Assets/Plugins/Android/FirebaseApp.androidlib/res/values/google-services.xml

